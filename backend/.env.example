# FINN runs with none of these set: rules, numbers and charts need no model and no database.

PORT=3001

# Optional. Without it FINN keeps its cache and filings in backend/data/*.json.
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=finn

# Optional. One key turns on the written analysis (promise vs delivered, bios, bull/bear, Ask).
# The first key found wins. Gemini and Groq have free tiers.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# GLM_API_KEY=
# GLM_BASE_URL=
# GLM_MODEL=hyde/glm-5.3-flash
# Optional overrides for the two model tiers and for any OpenAI-compatible endpoint.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_FAST_MODEL=
# LLM_SMART_MODEL=

# Optional hardening. Defaults suit one instance serving its own client.
# CORS_ORIGIN=https://your-client.example   # only if the client is hosted on another origin
# TRUST_PROXY=1                              # behind one reverse proxy (Render, Railway, nginx)
# MODEL_RATE_LIMIT=30                        # model calls per client IP per 10 minutes (Ask, Read it for me)
# ANALYSIS_PER_HOUR=12                       # new company analyses per client IP per hour
# LLM_DAILY_TOKENS=2000000                   # fresh model tokens per UTC day across all users; 0 = no cap
